@model List<Category>
@{
    ViewData["Title"] = "Kategorier";
}
<h1 class="h2 mb-1">Produktkategorier</h1>
<p class="text-muted">Vælg en kategori for at se produkter, typiske problemer og hvad der er godt.</p>

<div class="row g-4">
    @foreach (var category in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 product-card">
                <div class="card-body">
                    <h2 class="h5">
                        <span class="me-1">@category.Icon</span>
                        <a class="text-decoration-none text-dark" asp-action="Details" asp-route-slug="@category.Slug">@category.Name</a>
                    </h2>
                    <p class="small text-muted">@category.Description</p>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var child in category.Children.OrderBy(c => c.Name).Take(8))
                        {
                            <a class="badge bg-secondary-subtle text-secondary-emphasis text-decoration-none"
                               asp-action="Details" asp-route-slug="@child.Slug">@child.Name</a>
                        }
                        @if (category.Children.Count > 8)
                        {
                            <span class="badge bg-light text-muted">+@(category.Children.Count - 8) mere</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
