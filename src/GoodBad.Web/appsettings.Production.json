{
  // Pin the MySQL flavour if auto-detection is not possible on the web hotel,
  // e.g. "8.0.42" (MySQL 8) or "10.11.6-MariaDB". Leave empty to auto-detect.
  "Database": {
    "ServerVersion": ""
  },

  // ---------------------------------------------------------------------
  //  Connection string til Simply.com MySQL
  // ---------------------------------------------------------------------
  //  Find værdierne i Simply-kontrolpanelet under
  //  "Administration -> Loginoplysninger -> MySQL" (eller i phpMyAdmin).
  //
  //    Server   = MySQL-serveren, fx mysql12.simply.com
  //    Database = databasenavnet, fx goodbad eller brugernavn_goodbad
  //    User     = databasebrugeren (den samme bruger kan bruge alle dine
  //               3 MySQL-databaser)
  //    Password = adgangskoden fra kontrolpanelet
  //
  //  Eksempel (byg strengen om til én linje):
  //    Server=mysql12.simply.com;Port=3306;Database=goodbad;User=ditbrugernavn_goodbad;
  //    Password=DIN-ADGANGSKODE;Character Set=utf8mb4;SslMode=Preferred;
  //    AllowPublicKeyRetrieval=True;
  //
  //  Du behøver ikke oprette tabellerne selv: appen kører EF Core-migrationerne
  //  og seeder indholdet ved første start. Vil du hellere importere skemaet på
  //  forhånd (fx for at se det i MySQL Workbench / Visual Studio Server
  //  Explorer), så importér database/goodbad-mysql.sql i phpMyAdmin.
  //
  //  Brug ikke specialtegn i adgangskoden som ";" eller """ - vælg en kode
  //  med bogstaver, tal og fx ! # % -.
  // ---------------------------------------------------------------------
  "ConnectionStrings": {
    "DefaultConnection": "Server=mysqlXX.simply.com;Port=3306;Database=goodbad;User=BRUGER;Password=ADGANGSKODE;Character Set=utf8mb4;SslMode=Preferred;AllowPublicKeyRetrieval=True;"
  },

  // Din egen e-mail her -> kontoen bliver administrator ved næste opstart.
  "Admin": {
    "Emails": []
  },

  // Kan også sættes under /Admin/Settings (dér vinder den over denne fil).
  "Integrations": {
    "YouTube": {
      "ApiKey": ""
    },
    "Reddit": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "Storage": {
    "UploadWebPath": "/uploads"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
