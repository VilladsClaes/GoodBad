{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ----------------------------- Database ---------------------------------
  // MySQL (the database type available on Simply.com alongside the single
  // MS SQL database). The connection string itself lives in
  // appsettings.Production.json - see README.md section 4.
  //
  // Leave ServerVersion empty to auto-detect on startup, or pin it, e.g.
  // "8.0.42" (MySQL) or "10.11.6-MariaDB" (MariaDB).
  "Database": {
    "ServerVersion": ""
  },

  // ----------------------------- Uploads ----------------------------------
  // Photos are stored in wwwroot/uploads. If the web hotel does not allow
  // writing there, the app falls back to App_Data/uploads automatically.
  //   UploadWebPath = the public URL prefix (default "/uploads")
  //   UploadFolder  = optional custom folder (relative to the site or absolute)
  "Storage": {
    "UploadWebPath": "/uploads",
    "MaxImageBytes": 8388608,
    "AllowedExtensions": ".jpg,.jpeg,.png,.webp,.gif,.bmp"
  },

  // --------------------------- Integrations -------------------------------
  // Both the YouTube key and the Reddit credentials can also be set from
  // /Admin/Settings, which overrides whatever is written here.
  "Integrations": {
    "YouTube": {
      "ApiKey": "",
      "MaxResults": 3,
      "CacheMinutes": 1440
    },
    "Reddit": {
      "UserAgent": "GoodBad/1.0 (product-review platform; by /u/goodbad)",
      "ClientId": "",
      "ClientSecret": "",
      "MaxResults": 3,
      "CacheMinutes": 360
    }
  },

  // ------------------------------ Admin -----------------------------------
  // E-mails listed here are promoted to the Admin role on every startup.
  "Admin": {
    "Emails": [],
    "AutoPromoteFirstUser": true
  }
}
