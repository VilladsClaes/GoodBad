<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS-konfiguration til Simply.com (self-contained deployment, win-x86).

  Punkt 1: "processPath" peger på den publicerede .exe.
  Punkt 2: "hostingModel=outofprocess" anbefales af Simply, fordi et webhotel
           kun har én application pool.
  Punkt 3: "stdoutLogEnabled" kan sættes til true midlertidigt, hvis siden
           giver 500/503, så fejlen kan læses i logs\stdout_*.log.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\GoodBad.Web.exe"
                  arguments=""
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
