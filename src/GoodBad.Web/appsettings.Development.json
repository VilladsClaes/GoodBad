{
  // Lokal udvikling bruger også MySQL, men en lokal server i stedet for
  // webhotellets. Kommentér connection string'en ind og tilpas den:
  //
  // "ConnectionStrings": {
  //   "DefaultConnection": "Server=localhost;Port=3306;Database=goodbad;User=root;Password=;Character Set=utf8mb4"
  // },
  //
  // ... eller sæt den som miljøvariabel, uden at gemme den i filen:
  //   export ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=goodbad;User=root;Password=;Character Set=utf8mb4"
  "Database": {
    "ServerVersion": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
