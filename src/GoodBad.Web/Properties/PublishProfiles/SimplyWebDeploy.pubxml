<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish-profil til Simply.com.

  Udfyld de fire pladsholdere nedenfor med oplysningerne fra Simplys
  kontrolpanel -> Administration -> Loginoplysninger:

    <MSDeployServiceURL>  Web Deploy-serveren, fx https://webdeploy.simply.com:8172/msdeploy.axd?site=DITDOMAENE.dk
    <DeployIisAppPath>    Dit webhotel, fx DITDOMAENE.dk
    <UserName>            Dit Web Deploy/FTP-brugernavn
    <Password>            Din adgangskode (kan udelades og indtastes i guiden)

  Herefter kan du publicere med Visual Studio (Build -> Publish) eller med:
    dotnet publish src/GoodBad.Web/GoodBad.Web.csproj -p:PublishProfile=SimplyWebDeploy
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>IIS</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <PublishFramework>net8.0</PublishFramework>

    <!-- Simply.com kræver self-contained + win-x86 for nyere .NET-versioner -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <MSDeployServiceURL>https://nt28.unoeuro.com:8172/msdeploy.axd?site=goodbad.villadsclaes.dk</MSDeployServiceURL>
    <DeployIisAppPath>goodbad.villadsclaes.dk</DeployIisAppPath>
    <UserName>villadsclaes.dk</UserName>
    <!-- Adgangskoden ligger i SimplyWebDeploy.pubxml.user (git-ignoreret) -->
    <AllowUntrustedCertificate>False</AllowUntrustedCertificate>
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <!-- Stop appen under deploy, så de låste .exe/.dll-filer kan overskrives -->
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
  </PropertyGroup>
</Project>
