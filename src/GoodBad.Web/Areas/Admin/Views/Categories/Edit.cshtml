@model CategoryEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Ny kategori" : "Rediger kategori"; var parents = (List<Category>)ViewBag.ParentCategories; }

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="card card-body shadow-sm" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label"></label>
        <select asp-for="ParentId" class="form-select">
            <option value="">– Ingen (topkategori) –</option>
            @foreach (var parent in parents)
            {
                <option value="@parent.Id">@parent.Name</option>
            }
        </select>
        <span asp-validation-for="ParentId" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="Icon" class="form-label"></label>
            <input asp-for="Icon" class="form-control" placeholder="🔧" />
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="SortOrder" class="form-label"></label>
            <input asp-for="SortOrder" type="number" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Gem</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Tilbage</a>
    </div>
</form>
