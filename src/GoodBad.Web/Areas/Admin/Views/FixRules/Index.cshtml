@model List<FixSuggestionRule>
@{ ViewData["Title"] = "Fix-regler"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Fix-regler <span class="text-muted fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-success" asp-action="Create">+ Ny regel</a>
</div>

<p class="text-muted">
    Når en anmeldelse indeholder et af nøgleordene, foreslår systemet automatisk det linkede fix.
    Reglerne bruges <em>før</em> de automatiske YouTube- og Reddit-søgninger, så de er den mest præcise måde at styre forslagene på.
</p>

<div class="table-responsive">
    <table class="table table-sm align-middle bg-white">
        <thead><tr><th>Nøgleord</th><th>Forslag</th><th>Type</th><th>Link</th><th>Problem</th><th></th></tr></thead>
        <tbody>
        @foreach (var rule in Model)
        {
            <tr>
                <td>@rule.Keywords</td>
                <td>@rule.Title</td>
                <td><span class="badge bg-secondary">@rule.Kind</span></td>
                <td class="small text-truncate" style="max-width:260px">
                    @if (!string.IsNullOrWhiteSpace(rule.Url))
                    {
                        <a href="@rule.Url" target="_blank" rel="noopener">@rule.Url</a>
                    }
                </td>
                <td class="small text-muted">@(rule.Aspect?.Text ?? "–")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@rule.Id">Rediger</a>
                    <form asp-action="Delete" asp-route-id="@rule.Id" method="post" class="d-inline" onsubmit="return confirm('Slet reglen?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Slet</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
