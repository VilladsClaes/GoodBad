@model BrandEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Nyt brand" : "Rediger brand"; }

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="card card-body shadow-sm" style="max-width:760px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-7 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Country" class="form-label"></label>
            <input asp-for="Country" class="form-control" placeholder="Danmark" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="WebsiteUrl" class="form-label"></label>
        <input asp-for="WebsiteUrl" class="form-control" placeholder="https://" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="card mb-3">
        <div class="card-header py-2">Logo</div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <div class="mb-2"><img src="@Model.LogoUrl" alt="@Model.Name" style="max-height:60px" /></div>
            }
            @await Html.PartialAsync("_ImagePicker", new GoodBad.Web.ViewModels.ImagePickerModel
            {
                FileField = "LogoFile",
                UrlField = "LogoUrl",
                CurrentUrl = Model.LogoUrl,
                Label = "Logo",
                Hint = "Vælg en fil, eller indsæt et link til et logo."
            })
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Gem</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Tilbage</a>
    </div>
</form>
