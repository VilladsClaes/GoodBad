@model ProductEditViewModel
@{
    ViewData["Title"] = "Rediger produkt";
    var categories = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories;
    var brands = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Brands;
}

<h1 class="h3 mb-3">Rediger produkt</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body shadow-sm" style="max-width:860px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select" asp-items="categories">
                <option value="">– Vælg kategori –</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="BrandId" class="form-label"></label>
            <select asp-for="BrandId" class="form-select" asp-items="brands">
                <option value="">– Intet brand –</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ModelNumber" class="form-label"></label>
            <input asp-for="ModelNumber" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>

    @await Html.PartialAsync("_ImagePicker", new GoodBad.Web.ViewModels.ImagePickerModel
    {
        FileField = "ImageFile",
        UrlField = "ImageUrl",
        CurrentUrl = Model.ImageUrl,
        Label = "Produktbillede",
        Hint = "Tom felt + tom URL fjerner billedet."
    })

    <div class="form-check form-switch my-3">
        <input asp-for="IsRecommended" class="form-check-input" type="checkbox" />
        <label asp-for="IsRecommended" class="form-check-label"></label>
    </div>
    <div class="form-check form-switch mb-3">
        <input asp-for="IsHidden" class="form-check-input" type="checkbox" />
        <label asp-for="IsHidden" class="form-check-label"></label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Gem</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Tilbage</a>
        <a class="btn btn-outline-primary ms-auto" asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@ViewBag.Slug">Se på sitet</a>
    </div>
</form>
