@model List<Review>
@{
    ViewData["Title"] = "Anmeldelser";
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var filter = (string?)ViewBag.Filter;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<h1 class="h3 mb-3">Anmeldelser <span class="text-muted fs-6">(@ViewBag.Total)</span></h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-5"><input type="search" name="q" value="@ViewBag.Query" class="form-control form-control-sm" placeholder="Søg i tekst eller produkt" /></div>
    <div class="col-sm-4">
        <select name="filter" class="form-select form-select-sm">
            <option value="">Alle</option>
            <option value="bad" selected="@(filter == "bad")">Negative</option>
            <option value="good" selected="@(filter == "good")">Positive</option>
            <option value="hidden" selected="@(filter == "hidden")">Skjulte</option>
        </select>
    </div>
    <div class="col-sm-3"><button class="btn btn-sm btn-outline-secondary w-100">Filtrér</button></div>
</form>

<div class="table-responsive">
    <table class="table table-sm align-middle bg-white">
        <thead><tr><th>Produkt</th><th>Dom</th><th>Billede</th><th>Overskrift</th><th>Bruger</th><th>Dato</th><th></th></tr></thead>
        <tbody>
        @foreach (var review in Model)
        {
            <tr class="@(review.IsHidden ? "table-secondary" : "")">
                <td><a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@review.Product.Slug">@review.Product.Name</a></td>
                <td>
                    @if (review.Verdict == Verdict.Good)
                    {
                        <span class="badge bg-success">God</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Dårlig</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(review.ImageUrl))
                    {
                        <a href="@review.ImageUrl" target="_blank" rel="noopener">
                            <img src="@review.ImageUrl" alt="" style="width:52px;height:40px;object-fit:cover;border-radius:4px" />
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small">&ndash;</span>
                    }
                </td>
                <td class="small">@review.Title</td>
                <td class="small text-muted">@(review.User?.DisplayName ?? review.User?.Email ?? "–")</td>
                <td class="small text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yy")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@review.Product.Slug">Se</a>
                    <form asp-action="SetHidden" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@review.Id" />
                        <input type="hidden" name="value" value="@(!review.IsHidden)" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(review.IsHidden ? "Vis" : "Skjul")</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline" onsubmit="return confirm('Slet anmeldelsen?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Slet</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav><ul class="pagination pagination-sm">
        @for (var i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.Query" asp-route-filter="@filter">@i</a>
            </li>
        }
    </ul></nav>
}
